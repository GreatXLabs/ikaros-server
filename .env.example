# Configuracion del servidor Ikaros
# Copia este archivo como .env y completa los valores
# En Dokploy: carga este archivo en la seccion "Environment" del servicio

# Puerto TCP del servidor
SERVER_PORT=9000

# Conexion a MariaDB
# Opcion 1: URL completa (recomendado en Dokploy, usar la Internal Connection URL)
DB_URL=jdbc:mariadb://db:3306/ikaros

# Opcion 2: componentes individuales (solo si no se define DB_URL)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=ikaros

DB_USER=root
DB_PASSWORD=
